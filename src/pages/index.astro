---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pager from '../components/Pager.astro';
import { getPosts, paginate, postsByCategory, categoryUrl, postUrl, getTagIndex, tagUrl } from '../lib/posts';
import { CATEGORIES, SITE } from '../site';

const posts = await getPosts();
const { items, page, totalPages } = paginate(posts, 1);
const hotTags = getTagIndex(posts).slice(0, 12);

// 双主题分区：每个主题取最新 3 篇（设计方案 §P0「双主题分区首页」）
const topics = Object.entries(CATEGORIES).map(([key, label]) => {
  const list = postsByCategory(posts, key);
  return { key, label, count: list.length, latest: list.slice(0, 3) };
});
---
<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="hero">
    <span class="kicker">底层硬 · 表达软</span>
    <h1>Wentao's blog</h1>
    <p>企业研究（创业 · 商业 · 资本）与前沿 AI（现代 AI 沉淀）双线并行。把严肃的研究与前沿认知，讲得明白。</p>
  </section>

  <div class="topics">
    {topics.map((topic) => (
      <section class:list={['topic-panel', topic.key]}>
        <header>
          <h2>{topic.label}</h2>
          <a class="topic-more" href={categoryUrl(topic.key)}>查看全部 {topic.count} 篇 →</a>
        </header>
        {topic.latest.length > 0 ? (
          <ul class="topic-list">
            {topic.latest.map((post) => (
              <li>
                <a href={postUrl(post.id)}>{post.data.title}</a>
                <span class="topic-date">{post.data.date.getFullYear()}-{String(post.data.date.getMonth() + 1).padStart(2, '0')}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="topic-empty">该主题下暂无文章。</p>
        )}
      </section>
    ))}
  </div>

  <div class="toolbar">
    <div class="chips">
      <span class="chip active">全部</span>
      {Object.entries(CATEGORIES).map(([key, label]) => (
        <a class="chip" href={categoryUrl(key)}>{label}</a>
      ))}
    </div>
    <span class="count">共 {posts.length} 篇</span>
  </div>

  {items.length > 0 ? (
    <div class="grid">
      {items.map((post) => <PostCard {post} />)}
    </div>
  ) : (
    <div class="empty">还没有文章，先去 <a href="/about">关于页</a> 看看这个站在做什么。</div>
  )}

  <Pager base="/" {page} {totalPages} total={posts.length} />

  {hotTags.length > 0 && (
    <section class="home-tags">
      <h2>热门标签 <a href="/tags/">全部标签 →</a></h2>
      <div class="tag-cloud">
        {hotTags.map(({ tag, count }) => (
          <a class="tag-item" href={tagUrl(tag)}>
            <span class="tag-name">#{tag}</span>
            <span class="tag-count">{count}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
