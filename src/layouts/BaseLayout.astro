---
import '../styles/global.css';
import { SITE, CATEGORIES } from '../site';
import { categoryUrl } from '../lib/posts';

interface Props {
  title: string;
  description?: string;
  /** 用于 OG / canonical 的绝对路径，缺省取当前请求路径 */
  path?: string;
  /** 是否为文章页（决定 og:type） */
  article?: boolean;
  publishDate?: Date;
  /** OG / Twitter 卡片图，缺省用站点 logo */
  image?: string;
}

const {
  title,
  description = SITE.description,
  path,
  article = false,
  publishDate,
  image,
} = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image ?? '/og.svg', Astro.site ?? Astro.url);
const displayTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL('/rss.xml', Astro.site ?? Astro.url)}
    />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />

    <!--
      主题必须在首次绘制前确定，否则深色偏好下会先闪一帧浅色（FOUC）。
      localStorage 在隐私模式/被禁用时抛异常，因此整体包 try/catch。
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('wt-theme');
          var sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', saved || sys);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><img class="logo" src="/site-icon.png" alt="" width="30" height="30" />Wentao's blog</a>
        <form class="search" action="/search/" method="get" role="search">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input name="q" type="search" placeholder="搜索标题、标签、摘要…" autocomplete="off" />
        </form>
        <nav class="nav" id="nav">
          <a href="/">首页</a>
          {Object.entries(CATEGORIES).map(([key, label]) => (
            <a href={categoryUrl(key)}>{label}</a>
          ))}
          <a href="/archive/">归档</a>
          <a href="/tags/">标签</a>
          <a href="/about/">关于</a>
        </nav>
        <button class="hamburger" id="hamburger" aria-label="菜单" aria-controls="nav"><span></span><span></span><span></span></button>
        <button class="theme-toggle" id="themeBtn" title="切换深色/浅色" aria-label="切换主题">🌙</button>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© 2026 {SITE.author} · {SITE.name}</span>
        <span class="footer-links">
          {/* 平台入口已集中在首页侧栏「关注」区；Sitemap 由 robots.txt 声明给爬虫，都不必在页脚重复 */}
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
    <!-- 外链二次确认弹框：本站与目标页无关，提示访问风险 -->
    <div class="ext-confirm" id="extConfirm" role="dialog" aria-modal="true" aria-labelledby="extTitle">
      <div class="mask" data-close></div>
      <div class="ext-dialog">
        <h2 id="extTitle">离开本站</h2>
        <p>你即将离开本站。该站点内容与本站无关，请注意甄别信息、保护隐私与财产安全。</p>
        <span class="ext-url" id="extUrl"></span>
        <div class="ext-actions">
          <button class="ext-btn" type="button" data-close>取消</button>
          <a class="ext-btn go" id="extGo" href="#" rel="noopener noreferrer nofollow" target="_blank">继续访问</a>
        </div>
      </div>
    </div>
    <script>
      const btn = document.getElementById('themeBtn');
      const html = document.documentElement;
      /**
       * giscus 的 iframe 无法读取外层 CSS，只能通过 postMessage 换主题，
       * 否则切到深色后评论区仍是白底（详见 components/Comments.astro）。
       */
      const syncComments = (theme: string) => {
        const frame = document.querySelector<HTMLIFrameElement>('.giscus iframe');
        if (!frame?.contentWindow || !frame.src) return;
        const url = new URL(frame.src);
        url.searchParams.set('theme', theme === 'dark' ? 'transparent_dark' : 'light');
        frame.contentWindow.postMessage(
          { giscus: { setConfig: { theme: url.toString() } } },
          'https://giscus.app'
        );
      };
      const sync = () => {
        const theme = html.getAttribute('data-theme');
        if (btn) btn.textContent = theme === 'dark' ? '☀️' : '🌙';
        syncComments(theme ?? 'light');
      };
      sync();
      btn?.addEventListener('click', () => {
        const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        try {
          localStorage.setItem('wt-theme', next);
        } catch {
          /* 隐私模式下忽略即可 */
        }
        sync();
      });
      document.getElementById('hamburger')?.addEventListener('click', (e) => {
        e.stopPropagation();
        document.getElementById('nav')?.classList.toggle('open');
      });
      // 点击导航链接后自动关闭菜单
      document.getElementById('nav')?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          document.getElementById('nav')?.classList.remove('open');
        });
      });
      // 点击菜单外部关闭
      document.addEventListener('click', (e) => {
        const nav = document.getElementById('nav');
        const burger = document.getElementById('hamburger');
        if (nav?.classList.contains('open') && !nav.contains(e.target) && !burger?.contains(e.target as Node)) {
          nav.classList.remove('open');
        }
      });

      // ===== 顶栏智能隐藏：向下滚收起让位正文，向上滚立即浮出 =====
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        let lastY = window.scrollY;
        let ticking = false;
        const update = () => {
          ticking = false;
          const y = window.scrollY;
          const delta = y - lastY;
          if (Math.abs(delta) < 6) return; // 抖动阈值：小幅滚动不触发
          // 汉堡菜单或外链弹框展开时不收顶栏，否则展开内容会被一起带出视口
          const overlay = document.getElementById('nav')?.classList.contains('open')
            || document.getElementById('extConfirm')?.classList.contains('open');
          const hide = delta > 0 && y > header.offsetHeight && !overlay;
          header.classList.toggle('is-hidden', hide);
          lastY = y;
        };
        window.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        }, { passive: true });
      }

      // ===== 外链二次确认 =====
      const extConfirm = document.getElementById('extConfirm');
      const extGo = document.getElementById('extGo') as HTMLAnchorElement | null;
      const extUrl = document.getElementById('extUrl');
      const closeExt = () => extConfirm?.classList.remove('open');
      document.addEventListener('click', (e) => {
        const el = e.target as HTMLElement;
        if (el.closest('[data-close]')) {
          closeExt();
          return;
        }
        // 弹框内部（含「继续访问」按钮）不拦截
        if (el.closest('.ext-dialog')) return;
        const link = el.closest<HTMLAnchorElement>('a[href]');
        if (!link) return;
        const url = new URL(link.href);
        if (!/^https?:$/.test(url.protocol) || url.host === location.host) return;
        e.preventDefault();
        if (extGo) extGo.href = url.href;
        if (extUrl) extUrl.textContent = url.href;
        extConfirm?.classList.add('open');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeExt();
      });
      extGo?.addEventListener('click', () => closeExt());
    </script>
  </body>
</html>
