/** 文字占位的代表字：换成官方矢量后整块删掉 */
const MONO_CHARS: Record<string, string> = {
  即刻: '即',
  小宇宙: '宇',
  知识星球: '星',
};

const mark = MARKS[icon];
---
{mark ? (
  <svg class="social-mark" viewBox={mark.viewBox} width="20" height="20"
    aria-hidden="true" focusable="false" set:html={mark.body} />
) : (
  <span class="social-mono" aria-hidden="true">{MONO_CHARS[name] ?? name.slice(0, 1)}</span>
)}

<style>
  .social-mark{display:block;flex:0 0 auto}
  /* 没有官方矢量时的文字占位：取中性灰，避免猜错品牌色 */
  .social-mono{width:20px;height:20px;border-radius:6px;background:var(--line2);color:var(--ink2);
    font-size:11px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;
    flex:0 0 auto;line-height:1}
</style>
