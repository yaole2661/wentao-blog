---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getTagIndex, tagUrl } from '../lib/posts';

const posts = await getPosts();
const tags = getTagIndex(posts);
---
<BaseLayout title="标签" description="全站标签索引。">
  <section class="page-head">
    <span class="kicker">索引</span>
    <h1>全部标签</h1>
    <p>共 {tags.length} 个标签，点击查看该标签下的文章。</p>
  </section>
  {tags.length > 0 ? (
    <div class="tag-cloud">
      {tags.map(({ tag, count }) => (
        <a class="tag-item" href={tagUrl(tag)}>
          <span class="tag-name">#{tag}</span>
          <span class="tag-count">{count}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty">还没有标签。</div>
  )}
</BaseLayout>
