---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, groupByYear, postUrl } from '../lib/posts';
import { categoryLabel, formatDate } from '../site';

const posts = await getPosts();
const years = groupByYear(posts);
---
<BaseLayout title="归档" description="按时间归档的全部文章。">
  <section class="page-head">
    <span class="kicker">时间线</span>
    <h1>文章归档</h1>
    <p>共 {posts.length} 篇，跨越 {years.length} 个年份，按发布时间倒序。</p>
  </section>

  {years.length > 0 ? (
    years.map(({ year, items }) => (
      <section class="archive-year">
        <h2>{year} <span class="archive-count">{items.length} 篇</span></h2>
        <ul class="archive-list">
          {items.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <a href={postUrl(post.id)}>{post.data.title}</a>
              <span class="archive-cat">{categoryLabel(post.data.category)}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  ) : (
    <div class="empty">还没有文章。</div>
  )}
</BaseLayout>
