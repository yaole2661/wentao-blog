---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pager from '../components/Pager.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { getPosts, paginate, categoryUrl, postUrl, getTagIndex, tagUrl, type Post } from '../lib/posts';
import { CATEGORIES, SITE, SOCIALS, categoryLabel } from '../site';

const posts = await getPosts();
const { items, page, totalPages } = paginate(posts, 1);

/** 右侧栏容量：精选榜按 10 篇排，与上方「关注」区加起来与主列卡片流高度相当 */
const PICK_COUNT = 10;

/** 右侧「精选」榜单：标了 featured 的排前面，不足 10 篇时用最新文章补齐位置 */
const picks = [
  ...posts.filter((p) => p.data.featured),
  ...posts.filter((p) => !p.data.featured),
].slice(0, PICK_COUNT);

/** 榜单里的日期只到月份，避免窄栏换行 */
function ym(date: Date): string {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
}

function pickMeta(post: Post): string {
  return `${categoryLabel(post.data.category)} · ${ym(post.data.date)}`;
}

/** 顶栏「标签」入口迁到右侧栏：窄栏只放高频前 10 个，完整索引交给「全部标签」链接 */
const SIDE_TAG_COUNT = 10;
const sideTags = getTagIndex(posts).slice(0, SIDE_TAG_COUNT);
---
<BaseLayout title={SITE.name} description={SITE.description}>
  {/* 工具栏横跨整页宽度，右侧栏因此能与第一排卡片的顶端对齐 */}
  <div class="toolbar">
    <div class="chips">
      <span class="chip active">全部</span>
      {Object.entries(CATEGORIES).map(([key, label]) => (
        <a class="chip" href={categoryUrl(key)}>{label}</a>
      ))}
    </div>
    <span class="count">共 {posts.length} 篇</span>
  </div>

  <div class="home-layout">
    <div class="home-main">
      {items.length > 0 ? (
        <div class="grid">
          {items.map((post) => <PostCard {post} />)}
        </div>
      ) : (
        <div class="empty">还没有文章，先去 <a href="/about">关于页</a> 看看这个站在做什么。</div>
      )}

      <Pager base="/" {page} {totalPages} total={posts.length} />
    </div>

    <aside class="home-side">
      <section class="side-panel">
        <header>
          <h2>简介</h2>
        </header>
        <p class="side-intro">企业研究（创业 · 商业 · 资本）与前沿 AI（现代 AI 沉淀）双线并行。把严肃的研究与前沿认知，讲得明白。</p>
      </section>

      <section class="side-panel">
        <header>
          <h2>关注</h2>
          <a class="side-more" href="/about/">关于我 →</a>
        </header>
        <div class="social-grid">
          {SOCIALS.map((s) =>
            s.url ? (
              <a class="social-item" href={s.url} style={s.color ? { '--c': s.color } : undefined} target="_blank" rel="noopener noreferrer me">
                <SocialIcon icon={s.icon} />
                <span class="social-label">{s.name}</span>
              </a>
            ) : (
              <span class="social-item social-todo" style={s.color ? { '--c': s.color } : undefined} title={`${s.name}：主页链接待补充`}>
                <SocialIcon icon={s.icon} />
                <span class="social-label">{s.name}</span>
              </span>
            )
          )}
        </div>
      </section>

      <section class="side-panel">
        <header>
          <h2>精选</h2>
          <a class="side-more" href="/archive/">全部文章 →</a>
        </header>
        <ol class="pick-list">
          {picks.map((post) => (
            <li>
              <a href={postUrl(post.id)}>
                <span class="pick-main">
                  <span class="pick-title">{post.data.title}</span>
                  <span class="pick-meta">{pickMeta(post)}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="side-panel">
        <header>
          <h2>标签</h2>
          <a class="side-more" href="/tags/">全部标签 →</a>
        </header>
        {sideTags.length > 0 ? (
          <div class="side-tags">
            {sideTags.map(({ tag, count }) => (
              <a class="side-tag" href={tagUrl(tag)}>#{tag}<span>{count}</span></a>
            ))}
          </div>
        ) : (
          <p class="side-empty">还没有标签。</p>
        )}
      </section>
    </aside>
  </div>
</BaseLayout>
